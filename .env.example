# Copy this file to `.env` and fill in values as needed.

# DeepSeek (OpenAI-compatible) — preferred for the LLM report.
# NOTE: DeepSeek has no embeddings endpoint, so embeddings still need OpenAI
# or a local model (sentence-transformers).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API key — optional; used for embeddings and as a fallback LLM.
OPENAI_API_KEY=

# Model used for LLM report generation / agent reasoning.
OPENAI_MODEL=gpt-4.1-mini

# Embedding model used for the RAG vector index (OpenAI path).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
