# Copy this file to `.env` and fill in values as needed.

# OpenAI API key — required only for the optional LLM report and the agent.
# Leave empty to run fully offline with local models.
OPENAI_API_KEY=

# Model used for LLM report generation / agent reasoning.
OPENAI_MODEL=gpt-4.1-mini

# Embedding model used for the RAG vector index (OpenAI path).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
